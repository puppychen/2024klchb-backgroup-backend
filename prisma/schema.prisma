// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum ConsultantLevel {
  observer
  junior
  mid
  senior
}

enum ConsultationStatus {
  pending
  in_progress
  completed
  cancelled
}

enum AttachmentStatus {
  pending
  uploaded
  failed
}

enum AttachmentType {
  image
  audio
  video
  document
}

model Admin {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Uuid
  username  String   @unique
  password  String
  name      String
  email     String
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

model User {
  id                      Int               @id @default(autoincrement())
  uuid                    String            @unique @default(uuid()) @db.Uuid
  lineId                  String            @unique @map("line_id")
  name                    String?
  pictureUrl              String?           @map("picture_url")
  content                 Json?
  sourceKeyword           String?           @map("source_keyword")
  sourceKeywordAt         DateTime?         @map("source_keyword_at")
  chimeAppInstanceUserArn String?           @map("chime_app_instance_user_arn")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at")
  //
  Consultation            Consultation[]
  Message                 Message[]
  InviteLine              InviteLine[]
  Children                Children[]
  VaccineNotify           VaccineNotify[]
  VaccineNotifySendLog    VaccineNotifySendLog[]
  Note                    Note[]
  NoteAccessToken         NoteAccessToken[]
  SourceKeywordLog        SourceKeywordLog[]
  ChatRoom                ChatRoom[]
  ChatRoomMessage         ChatRoomMessage[]
  ActivitySubmission      ActivitySubmission[]

  @@map("users")
}

model ActivitySubmission {
  id                    Int      @id @default(autoincrement())
  uuid                  String   @unique @default(uuid()) @db.Uuid
  user                  User?    @relation(fields: [userId], references: [id])
  userId                Int?     @map("user_id")
  lineId                String   @map("line_id")
  activityCode          String   @map("activity_code")
  identity              String
  dueDate               String?  @map("due_date")
  babyBirth             String?  @map("baby_birth")
  pediatricianStatus    String?  @map("pediatrician_status")
  pediatricianClinic    Json?    @map("pediatrician_clinic")
  proofImageStoragePath String?  @map("proof_image_storage_path")
  formData              Json?    @map("form_data")
  profileSyncStatus     String?  @map("profile_sync_status")
  profileSyncError      String?  @map("profile_sync_error")
  linePushStatus        String?  @map("line_push_status")
  linePushError         String?  @map("line_push_error")
  submittedAt           DateTime @default(now()) @map("submitted_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId], name: "activity_submissions_user_id_index")
  @@index([activityCode], name: "activity_submissions_activity_code_index")
  @@map("activity_submissions")
}

model Children {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  name      String
  birthday  String
  months    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  VaccineNotify   VaccineNotify[]
  VaccineNotifySendLog VaccineNotifySendLog[]

  @@index([userId], name: "children_user_id_index")
  @@map("children")
}

model Consultation {
  id             Int                @id @default(autoincrement())
  uuid           String             @unique @default(uuid()) @db.Uuid
  user           User?              @relation(fields: [userId], references: [id])
  userId         Int?               @map("user_id")
  chatRoomId     Int?               @map("chat_room_id")
  chatRoom       ChatRoom?          @relation(fields: [chatRoomId], references: [id])
  lineName       String?            @map("line_name")
  name           String?
  phone          String?
  address        String?
  childName      String?            @map("child_name")
  yearSelected   String?            @map("year_selected")
  weight         String?
  primaryMedical String?            @map("primary_medical")
  topicSelected  String?            @map("topic_selected")
  content        String?
  formData       Json?              @map("form_data")
  status         ConsultationStatus @default(pending)
  submittedAt    DateTime?          @map("submitted_at")
  startedAt      DateTime?          @map("started_at")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([userId], name: "consultations_user_id_index")
  @@index([chatRoomId], name: "consultations_chat_room_id_index")
  @@index([status], name: "consultations_status_index")
  @@map("consultations")
}

model Consultant {
  id                      Int               @id @default(autoincrement())
  uuid                    String            @unique @db.Uuid
  username                String            @unique
  password                String
  name                    String
  email                   String?
  level                   ConsultantLevel   @default(junior)
  isActive                Boolean           @default(true) @map("is_active")
  chimeAppInstanceUserArn String?           @map("chime_app_instance_user_arn")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at")
  ChatRoomMessage         ChatRoomMessage[]

  @@map("consultants")
}

model ChatRoom {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @db.Uuid
  title              String?
  userId             Int                  @map("user_id")
  user               User                 @relation(fields: [userId], references: [id])
  chimeChannelArn    String?              @map("chime_channel_arn")
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")
  ChatRoomMessage    ChatRoomMessage[]
  ChatRoomAttachment ChatRoomAttachment[]
  Consultation       Consultation[]

  @@index([userId], name: "chat_rooms_user_id_index")
  @@index([chimeChannelArn], name: "chat_rooms_chime_channel_arn_index")
  @@map("chat_rooms")
}

model ChatRoomMessage {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @db.Uuid
  chatRoomId         Int                  @map("chat_room_id")
  chatRoom           ChatRoom             @relation(fields: [chatRoomId], references: [id])
  senderType         String               @map("sender_type")
  senderUserId       Int?                 @map("sender_user_id")
  senderUser         User?                @relation(fields: [senderUserId], references: [id])
  senderConsultantId Int?                 @map("sender_consultant_id")
  senderConsultant   Consultant?          @relation(fields: [senderConsultantId], references: [id])
  content            String?
  messageType        String               @default("text") @map("message_type")
  chimeMessageId     String?              @map("chime_message_id")
  isDeleted          Boolean              @default(false) @map("is_deleted")
  senderIp           String?              @map("sender_ip") @db.VarChar(45)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")
  ChatRoomAttachment ChatRoomAttachment[]

  @@index([chatRoomId], name: "chat_room_messages_chat_room_id_index")
  @@index([createdAt], name: "chat_room_messages_created_at_index")
  @@index([senderUserId], name: "chat_room_messages_sender_user_id_index")
  @@index([senderConsultantId], name: "chat_room_messages_sender_consultant_id_index")
  @@index([chatRoomId, isDeleted, createdAt], name: "chat_room_messages_room_deleted_created_index")
  @@map("chat_room_messages")
}

model ChatRoomAttachment {
  id                 Int              @id @default(autoincrement())
  uuid               String           @unique @db.Uuid
  chatRoomId         Int              @map("chat_room_id")
  chatRoom           ChatRoom         @relation(fields: [chatRoomId], references: [id])
  messageId          Int?             @map("message_id")
  message            ChatRoomMessage? @relation(fields: [messageId], references: [id])
  fileName           String           @map("file_name")
  fileSize           Int?             @map("file_size")
  fileType           String?          @map("file_type")
  attachmentType     AttachmentType   @default(document) @map("attachment_type")
  storagePath        String?          @map("storage_path")
  downloadUrl        String?          @map("download_url")
  downloadUrlExpires DateTime?        @map("download_url_expires")
  status             AttachmentStatus @default(pending)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([chatRoomId], name: "chat_room_attachments_chat_room_id_index")
  @@index([messageId], name: "chat_room_attachments_message_id_index")
  @@map("chat_room_attachments")
}

model Facility {
  id                 Int            @id @default(autoincrement())
  code               String         @unique
  name               String
  isChildCare        Boolean        @default(false) @map("is_child_care")
  isFluoride         Boolean        @default(false) @map("is_fluoride")
  isChildDevelopment Boolean        @default(false) @map("is_child_development")
  type               String?
  address            String?
  city               String?
  state              String?
  zip                String?
  phone              String?
  email              String?
  website            String?
  description        String?
  serviceInfo        Json?          @map("service_info")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at")
  FacilityUser       FacilityUser[]

  @@map("facilities")
}

model FacilityUser {
  id           Int       @id @default(autoincrement())
  facilityId   Int?      @map("facility_id")
  facility     Facility? @relation(fields: [facilityId], references: [id])
  lineId       String    @unique @map("line_id")
  lineName     String?   @map("line_name")
  facilityName String?   @map("facility_name")
  name         String?
  position     String?
  phone        String?
  checked      Boolean   @default(false)
  checkedNote  String?   @map("checked_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([lineId], name: "facility_users_line_id_index")
  @@map("facility_users")
}

model InviteLine {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?     @map("user_id")
  lineId    String   @unique @map("line_id")
  isInvited Boolean  @default(false) @map("is_invited")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("invite_lines")
}

model Message {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Uuid
  user         User?    @relation(fields: [userId], references: [id])
  userId       Int?     @map("user_id")
  topic        String?
  year         String?
  weight       String?
  startContent String?  @map("start_content")
  content      String?
  replyToken   String?  @map("reply_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([updatedAt], name: "messages_updated_at_index")
  @@map("messages")
}

model Vaccine {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.Uuid
  name      String
  months    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("vaccines")
}

model VaccineNotify {
  id             Int                    @id @default(autoincrement())
  uuid           String                 @unique @default(uuid()) @db.Uuid
  userId         Int                    @map("user_id")
  user           User?                  @relation(fields: [userId], references: [id])
  childId        Int?                   @map("child_id")
  child          Children?              @relation(fields: [childId], references: [id])
  name           String // Child's name
  vaccineName    String                 @map("vaccine_name")
  months         Int // Age in months when notification is triggered
  birthday       String
  cycleYearMonth String?                @map("cycle_year_month")
  status         String                 @default("pending")
  sendBatchId    String?                @map("send_batch_id")
  notifyAt       DateTime?              @map("notify_at") // When notification was sent, null if not sent yet
  sentAt         DateTime?              @map("sent_at")
  attemptedAt    DateTime?              @map("attempted_at")
  attemptCount   Int                    @default(0) @map("attempt_count")
  message        String?
  errorMessage   String?                @map("error_message")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at")
  SendLogs       VaccineNotifySendLog[]

  @@index([userId], name: "vaccine_notify_user_id_index")
  @@index([childId], name: "vaccine_notify_child_id_index")
  @@index([cycleYearMonth, status], name: "vaccine_notify_cycle_status_index")
  @@index([sendBatchId], name: "vaccine_notify_send_batch_id_index")
  @@map("vaccine_notifies")
}

model VaccineNotifySendLog {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid()) @db.Uuid
  vaccineNotifyId Int           @map("vaccine_notify_id")
  vaccineNotify   VaccineNotify @relation(fields: [vaccineNotifyId], references: [id], onDelete: Cascade)
  userId          Int           @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  childId         Int?          @map("child_id")
  child           Children?     @relation(fields: [childId], references: [id])
  lineId          String        @map("line_id")
  sendBatchId     String        @map("send_batch_id")
  message         String?
  status          String
  errorMessage    String?       @map("error_message")
  sentAt          DateTime?     @map("sent_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([sendBatchId], name: "vaccine_notify_send_logs_batch_index")
  @@index([userId, childId], name: "vaccine_notify_send_logs_user_child_index")
  @@map("vaccine_notify_send_logs")
}

model Note {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid()) @db.Uuid
  userId          Int               @map("user_id")
  user            User              @relation(fields: [userId], references: [id])
  accessTokenId   Int?              @map("access_token_id")
  accessToken     NoteAccessToken?  @relation(fields: [accessTokenId], references: [id])
  content         String?           @db.Text
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  NoteEditHistory NoteEditHistory[]

  @@index([userId], name: "notes_user_id_index")
  @@index([deletedAt], name: "notes_deleted_at_index")
  @@index([accessTokenId], name: "notes_access_token_id_index")
  @@map("notes")
}

model NoteAccessToken {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid()) @db.Uuid
  userId          Int               @map("user_id")
  user            User              @relation(fields: [userId], references: [id])
  expireAt        DateTime          @map("expire_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  Note            Note[]
  NoteEditHistory NoteEditHistory[]

  @@index([userId], name: "note_access_token_user_id_index")
  @@index([expireAt], name: "note_access_token_expire_at_index")
  @@map("note_access_tokens")
}

model NoteEditHistory {
  id            Int              @id @default(autoincrement())
  uuid          String           @unique @default(uuid()) @db.Uuid
  noteId        Int              @map("note_id")
  note          Note             @relation(fields: [noteId], references: [id])
  accessTokenId Int?             @map("access_token_id")
  accessToken   NoteAccessToken? @relation(fields: [accessTokenId], references: [id])
  beforeContent String?          @map("before_content") @db.Text
  afterContent  String?          @map("after_content") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([noteId], name: "note_edit_history_note_id_index")
  @@index([accessTokenId], name: "note_edit_history_access_token_id_index")
  @@map("note_edit_history")
}

// ===== Source Keyword Log =====

model SourceKeywordLog {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.Uuid
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  lineId        String   @map("line_id")
  action        String
  newKeyword    String   @map("new_keyword")
  newSourceName String   @map("new_source_name")
  oldKeyword    String?  @map("old_keyword")
  oldSourceName String?  @map("old_source_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId], name: "source_keyword_log_user_id_index")
  @@index([lineId], name: "source_keyword_log_line_id_index")
  @@map("source_keyword_logs")
}

// ===== Source Keyword Model =====

model SourceKeyword {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @db.Uuid
  keyword     String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("source_keywords")
}
